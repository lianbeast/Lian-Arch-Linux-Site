# Copy to `.env.local` and fill in to override defaults.
# Vite only exposes variables prefixed with VITE_ to client code.

# Base URL for the package-search proxy.
#
# archlinux.org does not send an Access-Control-Allow-Origin header, so the
# browser cannot call its package API directly. Requests currently go through a
# third-party text-echo proxy that adds the header back. That is the only
# external runtime dependency on this site.
#
# Point this at a proxy you control (a Cloudflare Worker or a small serverless
# function is enough) to remove the dependency entirely. The query string is
# appended directly to this value, so it must end with whatever separator your
# endpoint expects.
#
# Leaving it blank falls back to the built-in default.
VITE_PKG_API=
